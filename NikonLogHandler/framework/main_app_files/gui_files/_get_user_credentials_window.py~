def encrypt_message(message):
    """
    Encrypt the provided message using the Windows Data Protection API (DPAPI).dddd

    Args:
    - message: The message to be encrypted, as bytes.

    Returns:
    - The encrypted message, as bytes.
    """
    encrypted_message = CryptProtectData(message, "Description", None, None, None, 0)
    return encrypted_message


def decrypt_message(encrypted_message):
    """
    Decrypt the provided message using the Windows Data Protection API (DPAPI).

    Args:
    - encrypted_message: The encrypted message to be decrypted, as bytes.

    Returns:
    - The decrypted message, as bytes.
    """
    try:
        decrypted_message = CryptUnprotectData(encrypted_message, None, None, None, 0)[1]
    except pywintypes.error:
        return None

def try_load_saved_credentials():
    """
    Try to load saved credentials from a file named 'data.info'.

    Returns:
    - A tuple of (username, password) if credentials are successfully loaded and decrypted.
    - (None, None) if credentials are not found or an error occurs.
    """
    credentials_path = "data.info"
    if os.path.exists(credentials_path):
        try:
            with open(credentials_path, "rb") as credentials_file:
                encrypted_password = credentials_file.readline().strip()
            if decrypt_message(encrypted_password):
                return decrypt_message(encrypted_password).decode('utf-16-le')
            else:
                return None
        except Exception as e:
            logging.error(f"An error occurred while loading credentials: {e}")
    return None

# Call try_load_saved_credentials() once at the start of the program
GLOBAL_PASSWORD = try_load_saved_credentials()
GLOBAL_USERNAME = get_outlook_mail_address()
WIDGETS_TEXT = {}

class GetUserCredentialsWindow:
    """
    A class to create a window for the user to input credentials.

    Args:
    - master: The parent tkinter widget.
    - run_command_with_user_credential: A callable that will be run with the user's credentials.
    - widgets_text: A dictionary containing the text for the UI elements.
    """

    def __init__(self, master, run_command_with_user_credential: callable):
        global GLOBAL_USERNAME, GLOBAL_PASSWORD, WIDGETS_TEXT
        self.master = master
        self.run_command_with_user_credential = run_command_with_user_credential
        self.__widgets_text = WIDGETS_TEXT
        if isinstance(GLOBAL_USERNAME, Exception):
            self.run_command_with_user_credential(None, None, get_user_credential_error=str(GLOBAL_USERNAME))
            global_exception_handler(type(GLOBAL_USERNAME), GLOBAL_USERNAME, GLOBAL_USERNAME.__traceback__, show_popup=False)
        else:
            if GLOBAL_PASSWORD is not None:
                # Attempt to log in with the saved credentials
                login_success = run_command_with_user_credential(GLOBAL_USERNAME, GLOBAL_PASSWORD)
                if not login_success:
                    # If login was unsuccessful, prompt the user to enter their credentials again
                    with open("data.info", "wb") as credentials_file:
                        pass
                    self.create_window()
            else:
                # If there are no saved credentials, prompt the user to enter them
                self.create_window()

    def create_window(self):
        """Create the login window."""
        self.window = customtkinter.CTkToplevel(self.master)
        self.setup_ui()

    def setup_ui(self):
        """Set up the user interface for the login window."""
        global GLOBAL_USERNAME
        self.window.title(self.__widgets_text.get('title_user_credentials', 'Login'))
        self.window.geometry("310x120")
        self.window.resizable(False, False)
        self.window.attributes('-topmost', 'true')
        self.window.protocol("WM_DELETE_WINDOW", self.on_closing)

        # Add UI components as specified in the __widgets_text dictionary
        self.window.columnconfigure(0, weight=1)
        self.window.columnconfigure(1, weight=1)

        # ============  Password Label And Entry ============
        self.label_username = customtkinter.CTkLabel(self.window, text=GLOBAL_USERNAME, font=('Roboto Medium', 16))
        self.label_username.grid(row=2, column=0, columnspan=2, sticky='ew', padx=10, pady=5)

        # ============  Password Label And Entry ============
        self.label_password = customtkinter.CTkLabel(self.window, text=self.__widgets_text['password'])
        self.label_password.grid(row=3, column=0, sticky='e', padx=10, pady=5)

        self.entry_password = customtkinter.CTkEntry(self.window, placeholder_text="")
        self.entry_password.grid(row=3, column=1, sticky='w', padx=10, pady=5)
        self.entry_password.configure(show="*")

        # ============  Buttons Frame ============
        self.buttons_frame = customtkinter.CTkFrame(self.window, bg_color='transparent', fg_color='transparent')
        self.buttons_frame.grid(row=4, column=0, columnspan=2, sticky='we')

        self.buttons_frame.columnconfigure(0, weight=1)
        self.buttons_frame.columnconfigure(1, weight=1)

        # ============  Buttons Frame -> Ok Button ============
        self.ok_button = customtkinter.CTkButton(master=self.buttons_frame, text=self.__widgets_text['ok_button'], width=100, height=25, command=self.get_user_name_password)
        self.ok_button.grid(row=0, column=0, padx=10, pady=5, sticky='e')

        # ============  Buttons Frame -> Cancel Button ============
        self.cancel_button = customtkinter.CTkButton(master=self.buttons_frame, text=self.__widgets_text['cancel_button'], width=100, height=25, command=self.on_closing)
        self.cancel_button.grid(row=0, column=1, padx=10, pady=5, sticky='w')

        self.window.grab_set()

    def get_user_name_password(self):
        """Retrieve the entered credentials, encrypt them, and run the provided command."""
        global GLOBAL_USERNAME, GLOBAL_PASSWORD  # Access the global variables
        GLOBAL_PASSWORD = self.entry_password.get().strip()
        self.window.grab_release()
        self.window.destroy()
        # encrypted_password = encrypt_message(GLOBAL_PASSWORD.encode('utf-16-le'))
        # with open("data.info", "wb") as credentials_file:
        #     pass
        # #     credentials_file.write(encrypted_password)
        login_success = self.run_command_with_user_credential(GLOBAL_USERNAME, GLOBAL_PASSWORD)
        if not login_success:
            # If login was unsuccessful, prompt the user to enter their credentials again
            with open("data.info", "wb") as credentials_file:
                pass

    def on_closing(self):
        """Handle the window closing event."""
        self.window.grab_release()
        self.window.destroy()
        self.run_command_with_user_credential(None, None)