"""
This script provides functionalities for managing user credentials, including encryption and decryption using the Windows Data Protection API (DPAPI) and retrieving the current user's email address from Outlook. It also includes a graphical user interface (GUI) for prompting the user to enter their credentials using the `customtkinter` library.

Functions:
- get_outlook_mail_address: Retrieves the current user's email address from Outlook.
- encrypt_message: Encrypts a message using DPAPI.
- decrypt_message: Decrypts an encrypted message using DPAPI.
- try_load_saved_credentials: Attempts to load and decrypt saved credentials from a file.

Classes:
- GetUserCredentialsWindow: A class to create a window for the user to input their credentials, with methods to handle UI setup and credential submission.

Global Variables:
- GLOBAL_PASSWORD: Stores the decrypted password loaded at the start of the program.
- GLOBAL_USERNAME: Stores the current user's email address retrieved from Outlook.
- WIDGETS_TEXT: A dictionary to store text for UI elements.
"""

import logging
import os
import customtkinter
import win32com.client
import pywintypes
import traceback

from win32crypt import CryptProtectData, CryptUnprotectData
from main_app_files.function_files.exception_handler_and_reporting import global_exception_handler, NlhException  # Import global exception handler and logger

def get_outlook_mail_address():
    """
    Try to get the email address of the user from outlook
    """
    try:
        # Create an instance of the Outlook application
        outlook = win32com.client.Dispatch("Outlook.Application").GetNamespace("MAPI")

        # Get the current user's email address from their mailbox
        mail_address = outlook.Session.CurrentUser.AddressEntry.GetExchangeUser().PrimarySmtpAddress
        return mail_address
    except Exception as e:
        # Return a custom exception with a specific message and the original traceback
        return NlhException("Failed to get user email address", original_traceback=traceback.format_exc())

