        widgets_text: dict with all the buttons and messages text {'open_folder':'text',
                                                                          'no_folder_selected':'text',
                                                                          'no_supported_log_found': 'text',
                                                                          'no_log_selected': 'text',
                                                                          '__log_file_list': 'text',
                                                                          'run_button': 'text',
                                                                          'running': 'text',
                                                                          'done': 'text',
                                                                          'error': 'text',
                                                                          'plotting_end': 'text',
                                                                          'plotting_start': 'text',
                                                                          'error_message': 'text'
                                                                          'select_log_type': 'text',
                                                                          'No_Data': text,
                                                                          'Plotting': text,
                                                                          'No_Data': text
                                                                          'plotting_error_message': text
                                                                          'open_plot_window': text}
        :return: None
        """
        no_supported_log_found = self.__widgets_text['no_supported_log_found']
        select_log_type = self.__widgets_text['select_log_type']
        self.__widgets_text = widgets_text
        self.open_folder_button.configure(text=self.__widgets_text['open_folder'])
        # self.file_select_label.configure(text=self.__widgets_text['__log_file_list'])

        # update the button
        self.folder_path_display.configure(text=self.__widgets_text['no_folder_selected'])
        self.__lunch_graph_button_Tooltip = ToolTip(self.__lunch_graph_button, msg=self.__widgets_text['open_plot_window_tooltip'], refresh=2, delay=1)

        # update dropdowns
        if self.log_type_dropdown.get() == no_supported_log_found:
            self.log_type_dropdown.configure(values=[], variable=customtkinter.StringVar(master=self, value=self.__widgets_text['no_supported_log_found']))
        if self.log_type_dropdown.get() == select_log_type:
            self.log_type_dropdown.configure(variable=customtkinter.StringVar(master=self, value=self.__widgets_text['select_log_type']))
        self.folder_path_display.configure(text=self.__widgets_text['no_folder_selected'])
        self.change_run_button_config(self.__widgets_text['no_log_selected'])
        if self.__plotting_window:
            self.__plotting_window.change_buttons_text_and_information_param(widgets_text={'select_log_type': self.__widgets_text['select_log_type'],
                                                                                           'no_supported_log_found': self.__widgets_text['no_supported_log_found'],
                                                                                           'No_Data': self.__widgets_text['No_Data'],
                                                                                           'Plotting': self.__widgets_text['Plotting'],
                                                                                           'plotting_error_message': self.__widgets_text['plotting_error_message'],
                                                                                           'error': self.__widgets_text['error'],
                                                                                           'open_jmp_tooltip': self.__widgets_text['open_jmp_tooltip'],
                                                                                           'open_excel_tooltip': self.__widgets_text['open_excel_tooltip']})

    def change_run_button_config(self, stats: str):
        """
        change configuration (color, text and stats) of the run button based on run_stats_option
        stats:
        """
        possible_stats = [self.__widgets_text['run_button'],
                          self.__widgets_text['running'],
                          self.__widgets_text['done'],
                          self.__widgets_text['error'],
                          self.__widgets_text['no_log_selected']]
        if stats not in possible_stats:
            raise ValueError(self.__widgets_text["status_can_only_be"] + possible_stats + f' {self.__widgets_text["got_instead"]} ' + stats)
        stats_color_and_mode = {self.__widgets_text['run_button']: ['#1F6AA5', 'normal'],
                                self.__widgets_text['no_log_selected']: ['transparent', 'disabled'],
                                self.__widgets_text['running']: ['#1F6AA5', 'disabled'],
                                self.__widgets_text['done']: ['#008316', 'disabled'],
                                self.__widgets_text['error']: ['#88001b', 'disabled']}
        self.run_button.configure(state=stats_color_and_mode[stats][1], text=stats, fg_color=stats_color_and_mode[stats][0])
        self.run_button.update()

    def tooltip_refresh_folder_path(self):
        """
        Create a tooltip over the folder path
        :return: __folder_path
        """
        if self.__folder_path is None or self.__folder_path == '':
            return self.__widgets_text['no_folder_selected']
        else:
            return self.__folder_path

    def open_folder_get_log_list(self):
        """
        Allow you to select a folder, get the log file list from the selected folder,
        and group them in a dictionary based on type only supported logs.
        """
        # Reset APP Parameters
        self.__log_file_list = {}
        self.__available_handler = {}
        self.__selected_log_type = None
        self.__selected_logs_list = None

        # Set the App to start status.
        self.set_description('Nikon Log Handler')
        self.__log_handler = None
        self.change_run_button_config(self.__widgets_text['no_log_selected'])
        self.log_file_list_box.clear_list()
        self.log_file_list_box.disable()
        self.log_type_dropdown.configure(values=[], variable=customtkinter.StringVar(master=self, value=self.__widgets_text['no_supported_log_found']))
        self.folder_path_display.configure(text=self.__widgets_text['no_folder_selected'])

        # Get File list from Selected Folder
        self.__folder_path = filedialog.askdirectory(title=self.__widgets_text['no_folder_selected'])
        if self.__folder_path:
            self.folder_path_display.configure(text='.../' + '/'.join(self.__folder_path.split('/')[-3:]) + '/')

            # Iterate over all files in the specified directory
            for file in os.listdir(self.__folder_path):
                if os.path.isfile(os.path.join(self.__folder_path, file)) and analysis_files.parsed_file_inductor not in file.split('\\')[-1] and file.split('.')[-1] \
                        not in self.file_ending_to_ignore:

                    # For each handler in the log handlers dictionary
                    for log_pattern in self.log_handlers_dict.keys():

                        # If the handler's log pattern is found in the file name
                        key_regx = re.compile(log_pattern)
                        if key_regx.search(file):

                            # For each handler information in the list for this log pattern
                            for handler in self.log_handlers_dict[log_pattern]:

                                # If this handler is not yet in the log file list, add it
                                if handler.log_handler_name not in self.__log_file_list:
                                    self.__log_file_list[handler.log_handler_name] = []

                                # Add the file to the log file list for this handler
                                self.__log_file_list[handler.log_handler_name].append(file)

                                # Add the handler to the available handlers
                                self.__available_handler[handler.log_handler_name] = {
                                    'log handler class name': handler.log_handler_class,
                                    'analysis option': handler.analysis_option_list
                                }

            if not self.__available_handler:  # check if there are supported logs, rise message if none.
                self.log_type_dropdown.configure(values=[],
                                                 variable=customtkinter.StringVar(value=self.__widgets_text['no_supported_log_found']))
                messagebox.showinfo(self.__widgets_text['open_folder'], self.__widgets_text['no_supported_log_found'])
            else:
                self.__save_path = self.__folder_path
                self.log_type_dropdown.configure(variable=customtkinter.StringVar(value=self.__widgets_text['select_log_type']),
                                                 values=[logType for logType in self.__available_handler])

    def log_type_selection(self, *args):
        """
        Handle DropDown menu selection
        """
        # Set start conditions
        self.change_run_button_config(self.__widgets_text['no_log_selected'])
        # Set information to the Selected log information
        self.__selected_log_type = self.log_type_dropdown.get()
        self.set_description(self.__selected_log_type)
        # check if selected valid log type if so enable list box an add log files list.
        if self.__selected_log_type != self.__widgets_text['select_log_type'] or self.__selected_log_type != self.__widgets_text['no_supported_log_found']:
            self.log_file_list_box.enable()
            self.log_file_list_box.add_items_list(self.__log_file_list[self.__selected_log_type])

    def get_selected_logs(self, evnet=None):
        """
        handle item selected event
        """
        self.__selected_logs_list = self.log_file_list_box.get_selected()
        if self.__selected_logs_list:
            self.change_run_button_config(self.__widgets_text['run_button'])
        else:
            self.change_run_button_config(self.__widgets_text['no_log_selected'])

    def start_analysis(self):
        """
        Start the analysis process by disabling certain widgets, showing a progress bar,
        dynamically importing and running the log handler, and using threading for the analysis.
        """
        # ============ handle data  ============
        self.open_folder_button.configure(state='disabled')
        self.log_type_dropdown.configure(state='disabled')
        self.log_file_list_box.disable()
        self.grab_set()
        self.run_button.destroy()
        self.run_button = None
        self.running_progress_bar = {'frame': customtkinter.CTkFrame(master=self.log_type_and_log_select_frame)}
        self.running_progress_bar['frame'].grid(row=0, column=2, sticky='we', padx=15, pady=0)
        self.running_progress_bar['label'] = customtkinter.CTkLabel(master=self.running_progress_bar['frame'], text=self.__widgets_text['running'])
        self.running_progress_bar['label'].grid(row=0, column=0, sticky='we', padx=0, pady=(0, 0))
        self.running_progress_bar['bar'] = customtkinter.CTkProgressBar(master=self.running_progress_bar['frame'], width=100)
        self.running_progress_bar['bar'].grid(row=1, column=0, sticky='we', padx=0, pady=(0, 0))
        self.running_progress_bar['bar'].start()

        # Get the module name and class name
        module_name = self.__selected_log_type.lower().replace(" ", "_")
        class_name = self.__available_handler[self.__selected_log_type]['log handler class name']

        # Dynamically import the module
        module = importlib.import_module(f'analysis_files.handler_files.{module_name}_log_handler')

        # Get the class from the module
        handler_class = getattr(module, class_name)

        # Create the handler instance
        handler_instance = handler_class(
            message_broker=self.message_broker,
            input_event=self.input_event,
            folder_Path=self.__folder_path,
            save_folder=self.__save_path,
            file_list=self.__selected_logs_list
        )

        # Define the callback function
        def handle_result(*args):
            """
            Callback function to handle the result of the analysis.

            :param args: Variable length argument list containing the result of the analysis.
            """
            self.handle_analysis_result(*args)

        # Use thread_runner
        thread_runner(
            master=self,
            func=handler_instance.log_files_parsing_and_saving,
            gui_callback=handle_result
        )

    def handle_analysis_result(self, *args):
        """
        Handle the result of the analysis by updating the GUI, displaying error messages if any,
        and plotting the data if the analysis was successful.

        :param args: Variable length argument list containing the log handler object and parsed file dictionary.
        """
        try:
            self.running_progress_bar['bar'].stop()
            self.running_progress_bar['bar'].destory()
            self.running_progress_bar['label'].destory()
            self.running_progress_bar['frame'].destory()
            self.running_progress_bar = None
        except:
            pass

        self.run_button = customtkinter.CTkButton(master=self.log_type_and_log_select_frame, command=self.start_analysis, state='disabled', width=100, text_color_disabled=('black', 'white'))
        self.run_button.grid(row=0, column=2, sticky='we', padx=15, pady=(10, 0))

        if not args or args[0] is None:
            self.grab_release()
            self.open_folder_button.configure(state='normal')
            self.log_type_dropdown.configure(state='normal')
            self.log_file_list_box.enable()
            self.__run_stats = self.__widgets_text['error']
            self.change_run_button_config(self.__run_stats)
            raise Exception
        else:
            log_handler_obj, parsed_file_dict, error_message = args[0], args[1], args[2]

        if not parsed_file_dict:
            self.__run_stats = self.__widgets_text['error']
            self.change_run_button_config(self.__run_stats)
            global_exception_handler(None, None, None, root=self.master, error_message=error_message, log_exception=False)
            self.grab_release()
            self.open_folder_button.configure(state='normal')
            self.log_type_dropdown.configure(state='normal')
            self.log_file_list_box.enable()
            return
        elif error_message:
            self.__run_stats = self.__widgets_text['error']
            global_exception_handler(None, None, None, root=self.master, error_message=error_message, log_exception=False)
        else:
            self.__run_stats = self.__widgets_text['done']
        self.change_run_button_config(self.__run_stats)

        # Plot Data
        logging.info(self.__widgets_text['plotting_start'])
        if self.__plotting_window:
            self.__plotting_window.load_handler_and_file_list(log_handler_name=self.__selected_log_type, log_handler_obj=log_handler_obj, parsed_file_dict=parsed_file_dict)
            self.__plotting_window.deiconify()
        else:
            self.__plotting_window = PlottingWindow(self,
                                                    log_handler_name=self.__selected_log_type,
                                                    parsed_file_dict=parsed_file_dict,
                                                    app_logo=self.__app_logo,
                                                    jmp_logo=self.__jmp_logo,
                                                    excel_logo=self.__excel_logo,
                                                    copy_graph=self.__copy_graph,
                                                    log_handler_obj=log_handler_obj,
                                                    widgets_text={'select_log_type': self.__widgets_text['select_log_type'],
                                                                  'no_supported_log_found': self.__widgets_text['no_supported_log_found'],
                                                                  'No_Data': self.__widgets_text['No_Data'],
                                                                  'Plotting': self.__widgets_text['Plotting'],
                                                                  'plotting_error_message': self.__widgets_text['plotting_error_message'],
                                                                  'error': self.__widgets_text['error'],
                                                                  'open_jmp_tooltip': self.__widgets_text['open_jmp_tooltip'],
                                                                  'open_excel_tooltip': self.__widgets_text['open_excel_tooltip'],
                                                                  'copy_graph_to_clipboard': self.__widgets_text['copy_graph_to_clipboard']}, )

        logging.info(self.__widgets_text['plotting_end'])
        self.grab_release()
        self.open_folder_button.configure(state='normal')
        self.log_type_dropdown.configure(state='normal')
        self.log_file_list_box.enable()

