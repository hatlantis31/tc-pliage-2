    @staticmethod
    def user_input(prompt_message):
        """
        General method to get input from user and handle cancel action.
        prompt_message: Prompt message for input dialog.
        :return: User's input or handle cancel action.
        """
        input_dialog = customtkinter.CTkInputDialog(text=prompt_message, title="Nikon Log Handler")
        user_input = input_dialog.get_input()

        # Check if "cancel" was clicked
        if user_input is None:
            raise ValueError(f"User canceled the {prompt_message} input dialog.")

        return user_input

    @staticmethod
    def display_message(message):
        """
        Display a message to the user on the first plan.
        message: The message to display.
        """
        CustomMessageBox(message)

    @staticmethod
    def select_file(title, file_type, file_extension):
        """
        Open a file dialog to select a file.
        :title: The title of the file dialog.
        :file_types: A list of file types to filter the files.
        :return: The path of the selected file.
        """
        logging.info(f"title: {title}, file_type: {file_type}, file_extension: {file_extension}")
        file_path = filedialog.askopenfilename(title=title, filetypes=[(file_type, file_extension)])
        if not file_path:
            raise ValueError("No file selected.")
        return file_path

    def get_date(self, min_date=None, max_date=None):
        """
        Show date selection dialog and return selected date.
        :param min_date: Minimum date for selection (ISO format string or None).
        :param max_date: Maximum date for selection (ISO format string or None).
        :return: Selected datetime or None.
        """
        from datetime import datetime

        # Convert ISO strings back to datetime objects if provided
        if min_date and isinstance(min_date, str):
            min_date = datetime.fromisoformat(min_date)
        if max_date and isinstance(max_date, str):
            max_date = datetime.fromisoformat(max_date)

        # Create and show the dialog
        dialog = DateSelectionDialog(parent=self, min_date=min_date, max_date=max_date)
        result = dialog.get_result()

        return result

    def check_messages(self):
        """
        This method will be called periodically to check if there is any message from the log handler.
        If there is a message, it will be processed and the result will be sent back to the log handler.
        """

        message = self.message_broker.receive_message()
        if message:
            self.process_message(message)

        self.after(100, self.check_messages)

    def process_message(self, message):
        """
        Process different types of messages from the log handler.
        message: The message received from the log handler.
        """
        try:
            if message['type'] == 'user_input':
                # Handle user input
                logging.info(f"Received user input request: {message}")
                prompt_message = message.get('prompt', '')
                result = self.user_input(prompt_message)

                # Send response back to the message broker if input is received
                if result is not None:
                    logging.info(f"Sending response: {result}")
                    self.message_broker.send_message({'type': 'response', 'result': result})
                    self.input_event.set()  # Signal any waiting thread that the response is ready


            elif message['type'] == 'display_message':
                # Handle message display
                logging.info(f"Received message display request: {message}")
                message_text = message.get('message', '')
                self.display_message(message_text)
                logging.info("Message displayed, sending release signal to parser.")
                self.message_broker.send_message({'type': 'response', 'result': 'OK'})
                self.input_event.set()


            elif message['type'] == 'select_file':
                # Handle file selection
                logging.info(f"Received file selection request: {message}")
                title = message.get('title', '')
                file_types = message.get('filetypes', '')
                file_extension = message.get('file_extension', '')
                result = self.select_file(title, file_types, file_extension)

                # Send response back to the message broker if a file is selected
                if result:
                    logging.info(f"Selected file: {result}")
                    self.message_broker.send_message({'type': 'response', 'result': result})
                    self.input_event.set()


            elif message['type'] == 'get_date':
                logging.info(f"Received date request: {message}")
                min_date = message.get('min_date', None)
                max_date = message.get('max_date', None)
                result = self.get_date(min_date, max_date)
                self.message_broker.send_message({'type': 'response', 'result': result})
                self.input_event.set()

        except ValueError as e:
            logging.warning(f"User input was cancelled: {e}")
            # Send a cancellation message back to the message broker
            self.message_broker.send_message({'type': 'cancellation', 'reason': str(e)})
            self.input_event.set()  # Signal any waiting thread that the response is ready
